{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "models": {
    "ToolRef": {
      "additionalProperties": false,
      "description": "Catalog identity of a tool: ``(namespace, name, version)``.\n\n``version`` is the tool's own schema version (>= 1), not an event version;\n§8's closed-evolution rule for events applies to tool schemas by the same\nspirit — a changed input_schema ships as a new version, never a silent\nsame-version edit.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "namespace": {
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "namespace",
        "name",
        "version"
      ],
      "title": "ToolRef",
      "type": "object"
    },
    "ToolResult": {
      "$defs": {
        "CoreError": {
          "additionalProperties": false,
          "description": "Stable wire shape for every error crossing a seam (§8).",
          "properties": {
            "code": {
              "$ref": "#/$defs/CoreErrorCode"
            },
            "details": {
              "$ref": "#/$defs/JsonObject"
            },
            "message": {
              "minLength": 1,
              "title": "Message",
              "type": "string"
            },
            "retryable": {
              "title": "Retryable",
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "title": "CoreError",
          "type": "object"
        },
        "CoreErrorCode": {
          "description": "Closed code registry from §8; R1 slices surface a subset of it.\n\nLater slices may need more codes, but codes are never removed or\nrenumbered: they are part of the wire contract.",
          "enum": [
            "ValidationError",
            "UnsupportedCapability",
            "NotFound",
            "SessionBusy",
            "Conflict",
            "IdempotencyConflict",
            "InvalidCursor",
            "PermissionDenied",
            "ApprovalUnavailable",
            "ApprovalExpired",
            "ToolTimeout",
            "ToolFailed",
            "ExecutionUnknown",
            "ProviderUnavailable",
            "ProviderStreamInterrupted",
            "ContextLimitExceeded",
            "SlowConsumer",
            "StorageCorrupt",
            "MigrationRequired",
            "SessionReadOnly",
            "SessionClosed",
            "LifecycleCleanupFailed"
          ],
          "title": "CoreErrorCode",
          "type": "string"
        },
        "JsonObject": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        "JsonValue": {},
        "ToolFileContent": {
          "additionalProperties": false,
          "description": "§2.1 L70: ``{type: \"file\", uri, mime, name?}``.\n\nEncodable/decodable on the wire (history keeps a restricted reference), but\nwith media disabled the URI must not be read or sent to the model — that\ngate is a runtime rule (§2.1 L72, M6), not a wire constraint.",
          "properties": {
            "mime": {
              "minLength": 1,
              "title": "Mime",
              "type": "string"
            },
            "name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Name"
            },
            "type": {
              "const": "file",
              "title": "Type",
              "type": "string"
            },
            "uri": {
              "minLength": 1,
              "title": "Uri",
              "type": "string"
            }
          },
          "required": [
            "type",
            "uri",
            "mime"
          ],
          "title": "ToolFileContent",
          "type": "object"
        },
        "ToolTextContent": {
          "additionalProperties": false,
          "description": "§2.1 L69: ``{type: \"text\", text}`` — the only content type R2 produces.",
          "properties": {
            "text": {
              "title": "Text",
              "type": "string"
            },
            "type": {
              "const": "text",
              "title": "Type",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "title": "ToolTextContent",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "§5.1 L245: adapter execution result — content first, never a bare string.\n\n``content`` may be empty only when ``structured_output`` carries the value\n(MCP ``structuredContent``); the model-readable-text requirement for tool\nterminal states is enforced on ``py.tool.finished`` data, not here — this\nis the raw adapter face before Invoker normalization (R2-S5).",
      "properties": {
        "content": {
          "items": {
            "discriminator": {
              "mapping": {
                "file": "#/$defs/ToolFileContent",
                "text": "#/$defs/ToolTextContent"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ToolTextContent"
              },
              {
                "$ref": "#/$defs/ToolFileContent"
              }
            ]
          },
          "title": "Content",
          "type": "array"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/CoreError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metadata": {
          "$ref": "#/$defs/JsonObject"
        },
        "structured_output": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "content"
      ],
      "title": "ToolResult",
      "type": "object"
    },
    "ToolSpec": {
      "$defs": {
        "JsonObject": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        "JsonValue": {}
      },
      "additionalProperties": false,
      "description": "§5.1 L244: the eight catalog fields shown to the provider per request.\n\n``supported_content_types`` is the subset of {\"text\",\"file\"} the tool's\nresults may contain; R2 builtins declare [\"text\"] only. Empty list means a\npurely structured result (``structured_output`` carries it, §2.1 L72).",
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "idempotency_support": {
          "title": "Idempotency Support",
          "type": "boolean"
        },
        "input_schema": {
          "$ref": "#/$defs/JsonObject"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "namespace": {
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "side_effects": {
          "title": "Side Effects",
          "type": "boolean"
        },
        "supported_content_types": {
          "items": {
            "enum": [
              "text",
              "file"
            ],
            "type": "string"
          },
          "title": "Supported Content Types",
          "type": "array"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "namespace",
        "name",
        "version",
        "description",
        "input_schema",
        "supported_content_types",
        "side_effects",
        "idempotency_support"
      ],
      "title": "ToolSpec",
      "type": "object"
    }
  },
  "module": "opencode.contracts.tools",
  "title": "opencode.contracts.tools: unified JSON Schema (R5-S4, CORE-CONTRACTS section 1 L17)"
}
