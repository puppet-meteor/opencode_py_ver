{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "models": {
    "CoreError": {
      "$defs": {
        "CoreErrorCode": {
          "description": "Closed code registry from §8; R1 slices surface a subset of it.\n\nLater slices may need more codes, but codes are never removed or\nrenumbered: they are part of the wire contract.",
          "enum": [
            "ValidationError",
            "UnsupportedCapability",
            "NotFound",
            "SessionBusy",
            "Conflict",
            "IdempotencyConflict",
            "InvalidCursor",
            "PermissionDenied",
            "ApprovalUnavailable",
            "ApprovalExpired",
            "ToolTimeout",
            "ToolFailed",
            "ExecutionUnknown",
            "ProviderUnavailable",
            "ProviderStreamInterrupted",
            "ContextLimitExceeded",
            "SlowConsumer",
            "StorageCorrupt",
            "MigrationRequired",
            "SessionReadOnly",
            "SessionClosed",
            "LifecycleCleanupFailed"
          ],
          "title": "CoreErrorCode",
          "type": "string"
        },
        "JsonObject": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        "JsonValue": {}
      },
      "additionalProperties": false,
      "description": "Stable wire shape for every error crossing a seam (§8).",
      "properties": {
        "code": {
          "$ref": "#/$defs/CoreErrorCode"
        },
        "details": {
          "$ref": "#/$defs/JsonObject"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "CoreError",
      "type": "object"
    }
  },
  "module": "opencode.contracts.errors",
  "title": "opencode.contracts.errors: unified JSON Schema (R5-S4, CORE-CONTRACTS section 1 L17)"
}
