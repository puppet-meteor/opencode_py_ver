{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "models": {
    "ErrorChunk": {
      "$defs": {
        "CoreError": {
          "additionalProperties": false,
          "description": "Stable wire shape for every error crossing a seam (§8).",
          "properties": {
            "code": {
              "$ref": "#/$defs/CoreErrorCode"
            },
            "details": {
              "$ref": "#/$defs/JsonObject"
            },
            "message": {
              "minLength": 1,
              "title": "Message",
              "type": "string"
            },
            "retryable": {
              "title": "Retryable",
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "title": "CoreError",
          "type": "object"
        },
        "CoreErrorCode": {
          "description": "Closed code registry from §8; R1 slices surface a subset of it.\n\nLater slices may need more codes, but codes are never removed or\nrenumbered: they are part of the wire contract.",
          "enum": [
            "ValidationError",
            "UnsupportedCapability",
            "NotFound",
            "SessionBusy",
            "Conflict",
            "IdempotencyConflict",
            "InvalidCursor",
            "PermissionDenied",
            "ApprovalUnavailable",
            "ApprovalExpired",
            "ToolTimeout",
            "ToolFailed",
            "ExecutionUnknown",
            "ProviderUnavailable",
            "ProviderStreamInterrupted",
            "ContextLimitExceeded",
            "SlowConsumer",
            "StorageCorrupt",
            "MigrationRequired",
            "SessionReadOnly",
            "SessionClosed",
            "LifecycleCleanupFailed"
          ],
          "title": "CoreErrorCode",
          "type": "string"
        },
        "JsonObject": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        "JsonValue": {}
      },
      "additionalProperties": false,
      "description": "§2.3 L98: terminal chunk — at most one of finish/error per request (L102).",
      "properties": {
        "error": {
          "$ref": "#/$defs/CoreError"
        },
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "provider_metadata": {
          "$ref": "#/$defs/JsonObject"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "type": {
          "const": "error",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "index",
        "type",
        "error"
      ],
      "title": "ErrorChunk",
      "type": "object"
    },
    "FinishChunk": {
      "$defs": {
        "FinishReason": {
          "description": "§2.3 L97: logical finish reasons; raw provider strings ride in raw_finish/raw_reason.",
          "enum": [
            "stop",
            "tool_calls",
            "length",
            "filter",
            "unknown"
          ],
          "title": "FinishReason",
          "type": "string"
        },
        "JsonObject": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        "JsonValue": {}
      },
      "additionalProperties": false,
      "description": "§2.3 L97: logical finish — reason + optional raw provider string.",
      "properties": {
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "provider_metadata": {
          "$ref": "#/$defs/JsonObject"
        },
        "raw_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Reason"
        },
        "reason": {
          "$ref": "#/$defs/FinishReason"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "type": {
          "const": "finish",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "index",
        "type",
        "reason"
      ],
      "title": "FinishChunk",
      "type": "object"
    },
    "GenerationRequest": {
      "$defs": {
        "JsonObject": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        "JsonValue": {},
        "LLMMessage": {
          "additionalProperties": false,
          "description": "§2.2 L80: role + content parts; only ContextBuilder produces these.",
          "properties": {
            "content": {
              "items": {
                "discriminator": {
                  "mapping": {
                    "reasoning": "#/$defs/LLMReasoningPart",
                    "text": "#/$defs/LLMTextPart",
                    "tool_call": "#/$defs/LLMToolCallPart",
                    "tool_result": "#/$defs/LLMToolResultPart"
                  },
                  "propertyName": "type"
                },
                "oneOf": [
                  {
                    "$ref": "#/$defs/LLMTextPart"
                  },
                  {
                    "$ref": "#/$defs/LLMReasoningPart"
                  },
                  {
                    "$ref": "#/$defs/LLMToolCallPart"
                  },
                  {
                    "$ref": "#/$defs/LLMToolResultPart"
                  }
                ]
              },
              "title": "Content",
              "type": "array"
            },
            "role": {
              "enum": [
                "system",
                "user",
                "assistant",
                "tool"
              ],
              "title": "Role",
              "type": "string"
            }
          },
          "required": [
            "role",
            "content"
          ],
          "title": "LLMMessage",
          "type": "object"
        },
        "LLMReasoningPart": {
          "additionalProperties": false,
          "description": "§2.2 L80 request content: reasoning part (replayed history).",
          "properties": {
            "text": {
              "title": "Text",
              "type": "string"
            },
            "type": {
              "const": "reasoning",
              "title": "Type",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "title": "LLMReasoningPart",
          "type": "object"
        },
        "LLMTextPart": {
          "additionalProperties": false,
          "description": "§2.2 L80 request content: plain text part.",
          "properties": {
            "text": {
              "title": "Text",
              "type": "string"
            },
            "type": {
              "const": "text",
              "title": "Type",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "title": "LLMTextPart",
          "type": "object"
        },
        "LLMToolCallPart": {
          "additionalProperties": false,
          "description": "§2.2 L80: assistant-issued call — id + name + JSON object input.",
          "properties": {
            "input": {
              "$ref": "#/$defs/JsonObject"
            },
            "name": {
              "minLength": 1,
              "title": "Name",
              "type": "string"
            },
            "tool_call_id": {
              "minLength": 1,
              "title": "Tool Call Id",
              "type": "string"
            },
            "type": {
              "const": "tool_call",
              "title": "Type",
              "type": "string"
            }
          },
          "required": [
            "type",
            "tool_call_id",
            "name",
            "input"
          ],
          "title": "LLMToolCallPart",
          "type": "object"
        },
        "LLMToolResultPart": {
          "additionalProperties": false,
          "description": "§2.2 L80: paired result — tool_call_id must match the originating call.\n\nPairing completeness (\"every legal tool_call_id has exactly one result\",\nacceptance C) is ContextBuilder/runner validation (R2-S4/S6); the wire shape\nonly carries the mandatory identity + name + content union. The MAAS adapter\nmaps this to the OpenAI tool role.",
          "properties": {
            "content": {
              "items": {
                "discriminator": {
                  "mapping": {
                    "file": "#/$defs/ToolFileContent",
                    "text": "#/$defs/ToolTextContent"
                  },
                  "propertyName": "type"
                },
                "oneOf": [
                  {
                    "$ref": "#/$defs/ToolTextContent"
                  },
                  {
                    "$ref": "#/$defs/ToolFileContent"
                  }
                ]
              },
              "title": "Content",
              "type": "array"
            },
            "name": {
              "minLength": 1,
              "title": "Name",
              "type": "string"
            },
            "tool_call_id": {
              "minLength": 1,
              "title": "Tool Call Id",
              "type": "string"
            },
            "type": {
              "const": "tool_result",
              "title": "Type",
              "type": "string"
            }
          },
          "required": [
            "type",
            "tool_call_id",
            "name",
            "content"
          ],
          "title": "LLMToolResultPart",
          "type": "object"
        },
        "ModelRef": {
          "additionalProperties": false,
          "description": "§2.1 L74: ``{provider, model}``; Phase 1 provider is fixed to maas.",
          "properties": {
            "model": {
              "minLength": 1,
              "title": "Model",
              "type": "string"
            },
            "provider": {
              "minLength": 1,
              "title": "Provider",
              "type": "string"
            }
          },
          "required": [
            "provider",
            "model"
          ],
          "title": "ModelRef",
          "type": "object"
        },
        "ToolFileContent": {
          "additionalProperties": false,
          "description": "§2.1 L70: ``{type: \"file\", uri, mime, name?}``.\n\nEncodable/decodable on the wire (history keeps a restricted reference), but\nwith media disabled the URI must not be read or sent to the model — that\ngate is a runtime rule (§2.1 L72, M6), not a wire constraint.",
          "properties": {
            "mime": {
              "minLength": 1,
              "title": "Mime",
              "type": "string"
            },
            "name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Name"
            },
            "type": {
              "const": "file",
              "title": "Type",
              "type": "string"
            },
            "uri": {
              "minLength": 1,
              "title": "Uri",
              "type": "string"
            }
          },
          "required": [
            "type",
            "uri",
            "mime"
          ],
          "title": "ToolFileContent",
          "type": "object"
        },
        "ToolSpec": {
          "additionalProperties": false,
          "description": "§5.1 L244: the eight catalog fields shown to the provider per request.\n\n``supported_content_types`` is the subset of {\"text\",\"file\"} the tool's\nresults may contain; R2 builtins declare [\"text\"] only. Empty list means a\npurely structured result (``structured_output`` carries it, §2.1 L72).",
          "properties": {
            "description": {
              "title": "Description",
              "type": "string"
            },
            "idempotency_support": {
              "title": "Idempotency Support",
              "type": "boolean"
            },
            "input_schema": {
              "$ref": "#/$defs/JsonObject"
            },
            "name": {
              "minLength": 1,
              "title": "Name",
              "type": "string"
            },
            "namespace": {
              "minLength": 1,
              "title": "Namespace",
              "type": "string"
            },
            "side_effects": {
              "title": "Side Effects",
              "type": "boolean"
            },
            "supported_content_types": {
              "items": {
                "enum": [
                  "text",
                  "file"
                ],
                "type": "string"
              },
              "title": "Supported Content Types",
              "type": "array"
            },
            "version": {
              "minimum": 1,
              "title": "Version",
              "type": "integer"
            }
          },
          "required": [
            "namespace",
            "name",
            "version",
            "description",
            "input_schema",
            "supported_content_types",
            "side_effects",
            "idempotency_support"
          ],
          "title": "ToolSpec",
          "type": "object"
        },
        "ToolTextContent": {
          "additionalProperties": false,
          "description": "§2.1 L69: ``{type: \"text\", text}`` — the only content type R2 produces.",
          "properties": {
            "text": {
              "title": "Text",
              "type": "string"
            },
            "type": {
              "const": "text",
              "title": "Type",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "title": "ToolTextContent",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "§2.2 L78: the full request face; ``ContextBuilder`` is the only producer.\n\nField set exactly per §2.2 L78: request_id (caller-chosen, non-empty, no\nprefix rule), model, messages, tools (both required keys; empty lists are\nlegal — \"no tools this generation\" is a state, not an absent field),\nmax_output_tokens, optional temperature, timeout_s.",
      "properties": {
        "max_output_tokens": {
          "minimum": 1,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/LLMMessage"
          },
          "title": "Messages",
          "type": "array"
        },
        "model": {
          "$ref": "#/$defs/ModelRef"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "response_format": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonObject"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "temperature": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "timeout_s": {
          "exclusiveMinimum": 0,
          "title": "Timeout S",
          "type": "number"
        },
        "tools": {
          "items": {
            "$ref": "#/$defs/ToolSpec"
          },
          "title": "Tools",
          "type": "array"
        }
      },
      "required": [
        "request_id",
        "model",
        "messages",
        "tools",
        "max_output_tokens",
        "timeout_s"
      ],
      "title": "GenerationRequest",
      "type": "object"
    },
