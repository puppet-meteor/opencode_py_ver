{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "models": {
    "AssistantMessage": {
      "$defs": {
        "AssistantReasoningPart": {
          "additionalProperties": false,
          "description": "§2.1 L33: reasoning part — optional per endpoint, never assumed present.",
          "properties": {
            "part_id": {
              "minLength": 1,
              "title": "Part Id",
              "type": "string"
            },
            "text": {
              "title": "Text",
              "type": "string"
            },
            "type": {
              "const": "reasoning",
              "title": "Type",
              "type": "string"
            }
          },
          "required": [
            "type",
            "part_id",
            "text"
          ],
          "title": "AssistantReasoningPart",
          "type": "object"
        },
        "AssistantTextPart": {
          "additionalProperties": false,
          "description": "§2.1 L33: text part — ``part_id`` + ``text``.",
          "properties": {
            "part_id": {
              "minLength": 1,
              "title": "Part Id",
              "type": "string"
            },
            "text": {
              "title": "Text",
              "type": "string"
            },
            "type": {
              "const": "text",
              "title": "Type",
              "type": "string"
            }
          },
          "required": [
            "type",
            "part_id",
            "text"
          ],
          "title": "AssistantTextPart",
          "type": "object"
        },
        "AssistantToolPart": {
          "additionalProperties": false,
          "description": "§2.1 L33: tool call part — the full plan/result state.\n\n``content`` is a required key (possibly ``[]`` while the call is pending);\nthe \"at least one model-readable text\" rule applies to tool terminal states\n(py.tool.finished, §2.1 L72), not to pending plans. State/effect vocabulary\nper §2.1 L35; transition legality is fold-owned (R2-S2), not wire-owned.",
          "properties": {
            "content": {
              "items": {
                "discriminator": {
                  "mapping": {
                    "file": "#/$defs/ToolFileContent",
                    "text": "#/$defs/ToolTextContent"
                  },
                  "propertyName": "type"
                },
                "oneOf": [
                  {
                    "$ref": "#/$defs/ToolTextContent"
                  },
                  {
                    "$ref": "#/$defs/ToolFileContent"
                  }
                ]
              },
              "title": "Content",
              "type": "array"
            },
            "effect_status": {
              "enum": [
                "not_started",
                "completed",
                "unknown"
              ],
              "title": "Effect Status",
              "type": "string"
            },
            "error": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CoreError"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "execution_id": {
              "minLength": 1,
              "title": "Execution Id",
              "type": "string"
            },
            "input": {
              "$ref": "#/$defs/JsonObject"
            },
            "name": {
              "minLength": 1,
              "title": "Name",
              "type": "string"
            },
            "state": {
              "enum": [
                "pending",
                "running",
                "succeeded",
                "failed",
                "denied",
                "cancelled",
                "unknown"
              ],
              "title": "State",
              "type": "string"
            },
            "structured_output": {
              "anyOf": [
                {
                  "$ref": "#/$defs/JsonValue"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "tool_call_id": {
              "minLength": 1,
              "title": "Tool Call Id",
              "type": "string"
            },
            "type": {
              "const": "tool",
              "title": "Type",
              "type": "string"
            }
          },
          "required": [
            "type",
            "tool_call_id",
            "execution_id",
            "name",
            "input",
            "state",
            "effect_status",
            "content"
          ],
          "title": "AssistantToolPart",
          "type": "object"
        },
        "CoreError": {
          "additionalProperties": false,
          "description": "Stable wire shape for every error crossing a seam (§8).",
          "properties": {
            "code": {
              "$ref": "#/$defs/CoreErrorCode"
            },
            "details": {
              "$ref": "#/$defs/JsonObject"
            },
            "message": {
              "minLength": 1,
              "title": "Message",
              "type": "string"
            },
            "retryable": {
              "title": "Retryable",
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "title": "CoreError",
          "type": "object"
        },
        "CoreErrorCode": {
          "description": "Closed code registry from §8; R1 slices surface a subset of it.\n\nLater slices may need more codes, but codes are never removed or\nrenumbered: they are part of the wire contract.",
          "enum": [
            "ValidationError",
            "UnsupportedCapability",
            "NotFound",
            "SessionBusy",
            "Conflict",
            "IdempotencyConflict",
            "InvalidCursor",
            "PermissionDenied",
            "ApprovalUnavailable",
            "ApprovalExpired",
            "ToolTimeout",
            "ToolFailed",
            "ExecutionUnknown",
            "ProviderUnavailable",
            "ProviderStreamInterrupted",
            "ContextLimitExceeded",
            "SlowConsumer",
            "StorageCorrupt",
            "MigrationRequired",
            "SessionReadOnly",
            "SessionClosed",
            "LifecycleCleanupFailed"
          ],
          "title": "CoreErrorCode",
          "type": "string"
        },
        "FinishReason": {
          "description": "§2.3 L97: logical finish reasons; raw provider strings ride in raw_finish/raw_reason.",
          "enum": [
            "stop",
            "tool_calls",
            "length",
            "filter",
            "unknown"
          ],
          "title": "FinishReason",
          "type": "string"
        },
        "JsonObject": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        "JsonValue": {},
        "ModelRef": {
          "additionalProperties": false,
          "description": "§2.1 L74: ``{provider, model}``; Phase 1 provider is fixed to maas.",
          "properties": {
            "model": {
              "minLength": 1,
              "title": "Model",
              "type": "string"
            },
            "provider": {
              "minLength": 1,
              "title": "Provider",
              "type": "string"
            }
          },
          "required": [
            "provider",
            "model"
          ],
          "title": "ModelRef",
          "type": "object"
        },
        "ToolFileContent": {
          "additionalProperties": false,
          "description": "§2.1 L70: ``{type: \"file\", uri, mime, name?}``.\n\nEncodable/decodable on the wire (history keeps a restricted reference), but\nwith media disabled the URI must not be read or sent to the model — that\ngate is a runtime rule (§2.1 L72, M6), not a wire constraint.",
          "properties": {
            "mime": {
              "minLength": 1,
              "title": "Mime",
              "type": "string"
            },
            "name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Name"
            },
            "type": {
              "const": "file",
              "title": "Type",
              "type": "string"
            },
            "uri": {
              "minLength": 1,
              "title": "Uri",
              "type": "string"
            }
          },
          "required": [
            "type",
            "uri",
            "mime"
          ],
          "title": "ToolFileContent",
          "type": "object"
        },
        "ToolTextContent": {
          "additionalProperties": false,
          "description": "§2.1 L69: ``{type: \"text\", text}`` — the only content type R2 produces.",
          "properties": {
            "text": {
              "title": "Text",
              "type": "string"
            },
            "type": {
              "const": "text",
              "title": "Type",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "title": "ToolTextContent",
          "type": "object"
        },
        "Usage": {
          "additionalProperties": false,
          "description": "§2.1 L74: five optional non-negative token counts; null means unknown.\n\nA count the endpoint did not report is ``null`` on the wire, never a\ndisguised ``0`` — only an actual provider zero is zero. ``cost_usd`` is a\nsibling field on the carrying message/chunk (§2.1 L28, §2.3 L96), not a\nUsage member: usage is metered data, cost is priced data.",
          "properties": {
            "cache_read": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Cache Read"
            },
            "cache_write": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Cache Write"
            },
            "input": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Input"
            },
            "output": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Output"
            },
            "reasoning": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Reasoning"
            }
          },
          "title": "Usage",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "§2.1 L28 assistant row: model/parts/status plus optional terminal facts.\n\nThe optional fields are the v1 wire set named by the contract itself\n(finish/raw_finish/usage/cost_usd/error/completed_at); *new* fields later\nmean a version bump + upcaster (§8 L348), never same-version optionals.",
      "properties": {
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "cost_usd": {
          "anyOf": [
            {
              "pattern": "^\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/CoreError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "finish": {
          "anyOf": [
            {
              "$ref": "#/$defs/FinishReason"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "minLength": 1,
          "pattern": "^msg_",
          "title": "Id",
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/JsonObject"
        },
        "model": {
          "$ref": "#/$defs/ModelRef"
        },
        "parts": {
          "items": {
            "discriminator": {
              "mapping": {
                "reasoning": "#/$defs/AssistantReasoningPart",
                "text": "#/$defs/AssistantTextPart",
                "tool": "#/$defs/AssistantToolPart"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/AssistantTextPart"
              },
              {
                "$ref": "#/$defs/AssistantReasoningPart"
              },
              {
                "$ref": "#/$defs/AssistantToolPart"
              }
            ]
          },
          "title": "Parts",
          "type": "array"
        },
        "raw_finish": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Finish"
        },
        "status": {
          "enum": [
            "running",
            "completed",
            "failed",
            "interrupted"
          ],
          "title": "Status",
          "type": "string"
        },
        "type": {
          "const": "assistant",
          "title": "Type",
          "type": "string"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "type",
        "created_at",
        "model",
        "parts",
        "status"
      ],
      "title": "AssistantMessage",
      "type": "object"
    },
